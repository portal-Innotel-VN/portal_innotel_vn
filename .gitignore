# .gitignore cho Perfex CRM (CodeIgniter 3) – bản sao production, an toàn để push lên GitHub

# =============================================================================
# 1. Cấu hình lõi chứa thông tin database, mật khẩu và các thông số server
# =============================================================================
application/config/app-config.php
application/config/database.php

# =============================================================================
# 2. Tài nguyên người dùng – uploads, media, file đính kèm khách hàng
# =============================================================================
uploads/
media/
form/

# =============================================================================
# 3. Thư mục tạm, log hệ thống, cache và bản sao lưu
# =============================================================================
temp/
backups/
application/cache/
application/logs/

# =============================================================================
# 4. Các file sinh ra bởi hệ điều hành và IDE (tránh commit rác)
# =============================================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Visual Studio Code & Antigravity IDE
.vscode/
*.code-workspace
.Antigravity/

# JetBrains (PhpStorm, IntelliJ, etc.)
.idea/
*.iml

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# macOS Finder metadata
._*

# =============================================================================
# 5. File sao lưu database (tránh lộ dữ liệu nhạy cảm)
# =============================================================================
*.sql
*.sql.gz
*.sqlite
*.sqlite3

# =============================================================================
# 6. Các file thư viện và môi trường (Composer, Node, Python)
# =============================================================================
vendor/
node_modules/
.venv/
package-lock.json
yarn.lock

# =============================================================================
# 7. Các file cấu hình môi trường-local
# =============================================================================
.env
.env.local
.env.*.local

# =============================================================================
# 8. Logs và lỗi PHP
# =============================================================================
error_log*
php-error.log
*.log

# =============================================================================
# 9. Các file bản sao tạm thời (*.bak, *.tmp, v.v.)
# =============================================================================
*.bak
*.tmp
*.temp
*.swp
*~

# =============================================================================
# 10. File & thư mục Test, Playwright CLI, Browser testing
# =============================================================================
.playwright-cli/
tests/
**/tests/
*_test.php
*Test.php
*.test.js
*.test.ts
*.spec.js
*.spec.ts
!modules/sales_pipeline/tests/
!modules/sales_pipeline/tests/Reminder_delivery_*_test.php
!modules/sales_pipeline/tests/Reminder_bell_inbox_test.php
